# ============================================================
# INFRAESTRUTURA DOCKER COMPOSE
# ============================================================
DOMAIN=seu-dominio.com.br
POSTGRES_USER=controllo
POSTGRES_PASSWORD=TROCAR_POR_SENHA_FORTE_ALEATORIA
POSTGRES_DB=controllo_db

# ============================================================
# BACKEND — fielmente copiado de backend/.env.example
# ============================================================

# ── Ambiente ────────────────────────────────────────────────────
# "production" ativa HSTS, desabilita /docs e exige segredos fortes.
CONTROLLO_ENV=production

# ── Autenticacao JWT ─────────────────────────────────────────────
# Gere com: openssl rand -hex 32
CONTROLLO_SECRET_KEY=GERAR_COM_openssl_rand_hex_32
CONTROLLO_TOKEN_EXPIRE_MINUTES=480

# ── Usuario mestre (admin inicial) ───────────────────────────────
CONTROLLO_MASTER_USER=admin
CONTROLLO_MASTER_PASSWORD=TROCAR_POR_SENHA_FORTE_COM_COMPLEXIDADE

# ── Banco de Dados ───────────────────────────────────────────────
# Aponta para o servico db do compose (hostname = db, nao localhost)
DATABASE_URL=postgresql://controllo:TROCAR_POR_SENHA_FORTE_ALEATORIA@db:5432/controllo_db

# ── CORS ─────────────────────────────────────────────────────────
# Dominio publico do frontend (mesmo valor de DOMAIN acima com https://)
CORS_ORIGINS=https://seu-dominio.com.br

# ── Amazon S3 (armazenamento de arquivos Excel gerados) ──────────
# Se vazio, usa sistema de arquivos local (volume backend_uploads)
S3_BUCKET=
S3_PREFIX=controllo
AWS_REGION=us-east-1
# Credenciais AWS — prefira IAM Role em vez de chaves estaticas
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Redis (rate limiting distribuido) ────────────────────────────
# Se vazio, usa memoria local (OK para instancia unica)
REDIS_URL=

# ── E-mail (alertas) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================================
# NOTA SOBRE NEXT_PUBLIC_API_URL
# ============================================================
# Esta variavel NAO vai aqui — ela e build-arg do frontend,
# definida no GitHub Actions (secret DOMAIN_PRODUCAO) durante
# a construcao da imagem Docker. Mudar o dominio em producao
# exige rebuild do frontend via CI.
