# ================================================================
# Controllo BPO — Variáveis de Ambiente (Backend)
# Copie este arquivo para .env e preencha os valores antes de subir.
# NUNCA commite o arquivo .env com valores reais.
# ================================================================

# ── Ambiente ────────────────────────────────────────────────────
# "production" ativa HSTS, desabilita /docs e exige segredos fortes.
CONTROLLO_ENV=production

# ── Autenticação JWT ─────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
CONTROLLO_SECRET_KEY=TROQUE_POR_UM_SEGREDO_LONGO_E_ALEATORIO
CONTROLLO_TOKEN_EXPIRE_MINUTES=480

# ── Usuário mestre (admin inicial) ───────────────────────────────
CONTROLLO_MASTER_USER=admin
CONTROLLO_MASTER_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# ── Banco de Dados ───────────────────────────────────────────────
# SQLite (dev): deixe vazio ou omita — usa data/data/controllo.db
# PostgreSQL (prod): forneça a URL completa
DATABASE_URL=postgresql://usuario:senha@host:5432/controllo

# ── CORS ─────────────────────────────────────────────────────────
# Origens extras separadas por vírgula (além de localhost e *.vercel.app)
CORS_ORIGINS=https://seu-dominio.com

# ── Amazon S3 (armazenamento de arquivos Excel gerados) ──────────
# Se vazio, usa sistema de arquivos local (não persistente em containers)
S3_BUCKET=nome-do-seu-bucket
S3_PREFIX=controllo
AWS_REGION=us-east-1
# Credenciais AWS — prefira IAM Role em vez de chaves estáticas
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Redis (rate limiting distribuído) ────────────────────────────
# Se vazio, usa memória local (OK para instância única)
REDIS_URL=redis://seu-redis-host:6379/0

# ── E-mail (alertas) ─────────────────────────────────────────────
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=noreply@exemplo.com
SMTP_PASSWORD=SENHA_SMTP
SMTP_FROM=noreply@exemplo.com
